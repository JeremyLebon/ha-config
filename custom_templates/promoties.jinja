{#- Promoties – herbruikbare macro's (geïmporteerd in packages/promoties.yaml) -#}

{#- Lidl: producten uit de aanbiedingen van je winkel die een trefwoord bevatten.
    Geeft een JSON-lijst terug: ["Naam – € prijs", ...]
    LIDL_SENSOREN: pas aan als je van winkel verandert. -#}
{%- macro lidl_producten() -%}
  {%- set bronnen = ['sensor.lidl_kortrijk_engelse_wandeling_offers',
                     'sensor.lidl_kortrijk_engelse_wandeling_offers_preview'] -%}
  {%- set kw = (states('input_text.lidl_trefwoorden') | lower).split(',')
               | map('trim') | reject('eq', '') | reject('eq', 'unknown') | list -%}
  {%- set ns = namespace(l=[]) -%}
  {%- if kw | count > 0 -%}
    {%- for st in expand(bronnen) -%}
      {%- for waarde in st.attributes.values() if waarde is list -%}
        {%- for i in waarde if i is mapping -%}
          {%- set naam = (i.get('title') or i.get('name') or i.get('fullTitle')
                          or i.get('product') or i.get('description') or '') | string -%}
          {%- if naam and kw | select('in', naam | lower) | list | count > 0 -%}
            {%- set p = i.get('price') -%}
            {%- set p = p.get('price', p.get('value')) if p is mapping else p -%}
            {%- set ns.l = ns.l + [naam ~ (' – € ' ~ p if p not in [none, ''] else '')] -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
  {{- ns.l | unique | list | to_json -}}
{%- endmacro -%}
